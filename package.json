{
  "name": "@iyulab/desktop-compact",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "tokens.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/button/dc-button.d.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/components/input/dc-input.d.ts",
      "import": "./dist/input.js"
    },
    "./select": {
      "types": "./dist/components/select/dc-select.d.ts",
      "import": "./dist/select.js"
    },
    "./textarea": {
      "types": "./dist/components/textarea/dc-textarea.d.ts",
      "import": "./dist/textarea.js"
    },
    "./dialog": {
      "types": "./dist/components/dialog/dc-dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./confirm-dialog": {
      "types": "./dist/components/confirm-dialog/dc-confirm-dialog.d.ts",
      "import": "./dist/confirm-dialog.js"
    },
    "./badge": {
      "types": "./dist/components/badge/dc-badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./spinner": {
      "types": "./dist/components/spinner/dc-spinner.d.ts",
      "import": "./dist/spinner.js"
    },
    "./card": {
      "types": "./dist/components/card/dc-card.d.ts",
      "import": "./dist/card.js"
    },
    "./empty-state": {
      "types": "./dist/components/empty-state/dc-empty-state.d.ts",
      "import": "./dist/empty-state.js"
    },
    "./section-heading": {
      "types": "./dist/components/section-heading/dc-section-heading.d.ts",
      "import": "./dist/section-heading.js"
    },
    "./tab-bar": {
      "types": "./dist/components/tab-bar/dc-tab-bar.d.ts",
      "import": "./dist/tab-bar.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "web-test-runner \"src/**/*.test.ts\"",
    "test:watch": "web-test-runner \"src/**/*.test.ts\" --watch",
    "guard": "node scripts/check-forge-tokens.mjs",
    "guard:test": "node --test scripts/*.test.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/web-components": "^8.3.0",
    "@storybook/web-components-vite": "^8.3.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^1.0.2",
    "@web/test-runner": "^0.19.0",
    "storybook": "^8.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.2.4"
  }
}
